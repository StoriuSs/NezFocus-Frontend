{
  "name": "react-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "docker:dev": "docker compose --env-file .env.development -f docker-compose.dev.yaml up -d --build --renew-anon-volumes",
    "docker:prod": "docker compose --env-file .env.production -f docker-compose.prod.yaml up -d --build",
    "docker:down": "docker compose -f docker-compose.dev.yaml down",
    "docker:down:prod": "docker compose -f docker-compose.prod.yaml down",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"k6/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"k6/**/*.js\"",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "load:spa": "k6 run k6/spa.js",
    "api:types": "node scripts/generate-api-types.mjs",
    "api:types:check": "node scripts/generate-api-types.mjs --check",
    "size": "size-limit",
    "check:fast": "node scripts/constraints/lint-changed.mjs && node scripts/constraints/floor-guard.mjs && node scripts/constraints/secrets.mjs",
    "check:task": "pnpm check:fast && tsc -b && node scripts/constraints/coverage-changed.mjs",
    "check:full": "pnpm lint && pnpm format:check && node scripts/constraints/floor-guard.mjs && node scripts/constraints/secrets.mjs && pnpm test && pnpm build && pnpm size && pnpm api:types:check ../NezFocus-Backend/openapi.json && pnpm audit --prod --audit-level high",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/unbounded": "^5.3.0",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@sentry/react": "10.74.0",
    "@tanstack/react-query": "^5.90.12",
    "axios": "^1.20.0",
    "camelcase-keys": "^10.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^25.7.4",
    "i18next-browser-languagedetector": "^8.2.0",
    "lucide-react": "^0.562.0",
    "nprogress": "^0.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-easy-crop": "^5.5.6",
    "react-hook-form": "^7.69.0",
    "react-i18next": "^16.5.3",
    "react-router-dom": "^7.18.4",
    "snakecase-keys": "^9.0.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.6.6",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.63.0",
    "@sentry/vite-plugin": "5.4.0",
    "@size-limit/file": "^14.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.4",
    "@types/nprogress": "^0.2.3",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.17",
    "autoprefixer": "^10.4.23",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.2.7",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "size-limit": "^14.3.0",
    "tailwindcss": "^3.4.17",
    "type-fest": "^5.9.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.0.17",
    "yaml": "^2.9.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "k6/**/*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.0.0"
  }
}
