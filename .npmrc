# pnpm config for this project.
# See: https://pnpm.io/npmrc
#
# Most pnpm settings live in pnpm-workspace.yaml on v10+, but a few still
# need to live here. Keep this file even if empty — it's referenced by the
# Dockerfile so future settings take effect without modifying the build.

# The Node version in package.json's "engines" is a requirement, not a wish:
# pnpm refuses to install or run scripts on another major. Without this, an
# older Node installs happily and the difference only shows up as tests that
# fail here and pass in CI (seen with Node 20 against a repository that needs
# 22). Use the version in .nvmrc: nvm use, fnm use, or volta pin.
engine-strict=true

# auto-install-peers: pnpm v10+ defaults this to true, no need to set.
# strict-peer-dependencies: leave at default (true) — surfaces real issues
# in dependency trees instead of silently picking a version.
