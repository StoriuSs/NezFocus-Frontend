# ============================================================================
# React Starter — Nginx site config (TEMPLATE)
# ============================================================================
# Single domain: frontend (static files served by an Nginx container behind
# the host's Nginx). Adapt as needed.
#
# Placeholders (replaced by bootstrap-nginx.sh via sed):
#   FRONTEND_DOMAIN    e.g.  app.example.com
#   FRONTEND_PORT      host port the frontend container binds to (default 8081)
#
# After installing:
#   1. sudo ln -s /etc/nginx/sites-available/<app> /etc/nginx/sites-enabled/
#   2. sudo nginx -t                       # validate
#   3. sudo systemctl reload nginx
#   4. sudo certbot --nginx -d FRONTEND_DOMAIN
#      ↑ certbot edits this file in place to add 443 server blocks + cert paths.
#
# Every directive lives INSIDE the server block. Files in sites-enabled/ are
# included into nginx's shared http{} context, so a directive written at the
# top level of this file applies to every site on the machine — and when a
# second site does the same (e.g. the Nest starter's config on the same VPS),
# nginx refuses to start: `"real_ip_header" directive is duplicate`.
# ============================================================================

# ─── Frontend ───────────────────────────────────────────────────────────────
server {
	listen 80;
	listen [::]:80;
	server_name FRONTEND_DOMAIN;
	server_tokens off;

	# HSTS: browsers refuse plain HTTP for this host for a year. Sent over
	# HTTP it is ignored, so it only takes effect once certbot has added the
	# 443 block (it copies this directive there). Add includeSubDomains or
	# preload only when every subdomain serves HTTPS.
	add_header Strict-Transport-Security "max-age=31536000" always;

	access_log /var/log/nginx/app-frontend-access.log;
	error_log  /var/log/nginx/app-frontend-error.log;

	# ── Cloudflare real-IP handling ─────────────────────────────────────
	# Rewrites $remote_addr to the real client IP when traffic comes through
	# Cloudflare's proxy. Safe to leave enabled with grey-cloud (DNS-only)
	# DNS — it's a no-op until traffic actually comes from a trusted
	# Cloudflare IP.
	#
	# To check for drift in Cloudflare's IP list:
	#   curl https://www.cloudflare.com/ips-v4
	#   curl https://www.cloudflare.com/ips-v6
	# Last refreshed: 2026-05-22.

	# Cloudflare IPv4 ranges
	set_real_ip_from 173.245.48.0/20;
	set_real_ip_from 103.21.244.0/22;
	set_real_ip_from 103.22.200.0/22;
	set_real_ip_from 103.31.4.0/22;
	set_real_ip_from 141.101.64.0/18;
	set_real_ip_from 108.162.192.0/18;
	set_real_ip_from 190.93.240.0/20;
	set_real_ip_from 188.114.96.0/20;
	set_real_ip_from 197.234.240.0/22;
	set_real_ip_from 198.41.128.0/17;
	set_real_ip_from 162.158.0.0/15;
	set_real_ip_from 104.16.0.0/13;
	set_real_ip_from 104.24.0.0/14;
	set_real_ip_from 172.64.0.0/13;
	set_real_ip_from 131.0.72.0/22;

	# Cloudflare IPv6 ranges
	set_real_ip_from 2400:cb00::/32;
	set_real_ip_from 2606:4700::/32;
	set_real_ip_from 2803:f800::/32;
	set_real_ip_from 2405:b500::/32;
	set_real_ip_from 2405:8100::/32;
	set_real_ip_from 2a06:98c0::/29;
	set_real_ip_from 2c0f:f248::/32;

	real_ip_header CF-Connecting-IP;
	real_ip_recursive on;

	# ── Limits ──────────────────────────────────────────────────────────
	# A static site receives no uploads; keep the body limit small.
	client_max_body_size 1M;
	proxy_read_timeout 60s;
	proxy_send_timeout 60s;

	# ── Proxy headers ───────────────────────────────────────────────────
	# $remote_addr is the REAL client IP — already rewritten above when
	# traffic comes from Cloudflare's edge.
	proxy_http_version 1.1;
	proxy_set_header Host              $host;
	proxy_set_header X-Real-IP         $remote_addr;
	# Set, not appended to: a client could otherwise send its own
	# X-Forwarded-For and pass for any address it likes (the API logs and
	# rate-limits by it).
	proxy_set_header X-Forwarded-For   $remote_addr;
	proxy_set_header X-Forwarded-Proto $scheme;
	proxy_set_header X-Forwarded-Host  $host;

	# Gzip for static assets (the container's own nginx also does this, but
	# layering it here means edges and clients see compressed responses too).
	gzip on;
	gzip_vary on;
	gzip_min_length 1024;
	gzip_types text/plain text/css text/javascript application/json application/javascript application/xml+rss application/atom+xml image/svg+xml;

	location / {
		proxy_pass http://127.0.0.1:FRONTEND_PORT;
	}
}
