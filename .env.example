# ==============================================================================
# Environment Configuration Template (Frontend)
#
# Copy this file to .env.development or .env.production and fill in your values:
#
#   cp .env.example .env.development   # local development
#   cp .env.example .env.production    # production (VPS)
#
# Both files are gitignored. Only this file is committed.
#
# In production these are NOT built into the app: the container reads them when
# it starts and writes them into /config.js for the browser, so one image runs
# in any environment (docs/deploy.md). Changing one needs a ./deploy.sh, not a
# new image. In development Vite reads .env.development as usual.
# ==============================================================================

# API URL (NestJS Backend)
# In dev: The host port you are running the backend on (default 8888)
# In prod: Your actual production API URL
VITE_API_URL=http://localhost:8888/api/v1

# Error tracking (Sentry; see docs/error-tracking.md)
# The DSN of a Sentry project for this app (platform React). It reaches the
# browser, so it is public by design: it can only send events. Empty: error
# tracking is off.
VITE_SENTRY_DSN=
# The release errors are filed under. Leave it out: the production build sets it
# to the commit deploy.sh is deploying.
# VITE_SENTRY_RELEASE=
# Sourcemap upload, so stack traces show the source (production build only,
# not bundled). All three, or none. The token is secret: an organization auth
# token (Settings → Developer Settings → Organization Tokens).
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=react-starter
# SENTRY_AUTH_TOKEN=

# Content-Security-Policy (production image only; not bundled into the app)
# Extra origins avatars may load from, space-separated. Images from the API and
# from any https:// host are already allowed, so this is only needed for a
# bucket served over plain http — e.g. local RustFS: http://localhost:9100 http://files.lan:9000 (space separated if multiple values)
CSP_IMG_SRC=

# Host port of the production container, bound to 127.0.0.1 for the host's
# nginx to proxy to (docker-compose.prod.yaml).
# FRONTEND_PORT=8081

# Deploy (read by deploy.sh on the server; see docs/deploy.md)
# build: the server builds the image itself (default).
# registry: it pulls the image CI built for the commit, from DEPLOY_IMAGE
# (e.g. ghcr.io/you/your-frontend).
# Either way the image holds no settings: the VITE_* values above stay in
# this file and reach the container when it starts.
# DEPLOY_IMAGE_SOURCE=build
# DEPLOY_IMAGE=react-starter-auth-prod-app
# DEPLOY_KEEP_IMAGES=3
# DEPLOY_HEALTH_TIMEOUT=120
